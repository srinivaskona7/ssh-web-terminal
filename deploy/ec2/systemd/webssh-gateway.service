[Unit]
Description=WebSSH Studio WebSocket-to-SSH/SFTP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webssh
Group=webssh
EnvironmentFile=/etc/webssh-gateway/gateway.env
ExecStart=/usr/local/bin/webssh-gateway
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
