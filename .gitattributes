# Every text file is stored and checked out with LF line endings.
# scripts/check-eol.mjs (npm run lint:eol) fails CI if CRLF reappears.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.wasm binary
