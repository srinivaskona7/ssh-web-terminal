{
  "$schema": "https://webssh.studio/schemas/tokens-v1.json",
  "version": "1.0.0",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "40px",
    "8": "48px",
    "terminalInset": "8px",
    "stopIcon": "11px",
    "separatorHeight": "18px"
  },
  "radius": {
    "none": "0px",
    "stopSquare": "3px",
    "sm": "6px",
    "md": "8px",
    "panel": "12px",
    "xl": "16px",
    "pill": "9999px"
  },
  "studio": {
    "outerBg": "#000000",
    "containerBg": "#131313",
    "containerBorder": "#262629",
    "terminalBg": "#282A36",
    "terminalFg": "#F0F0EC",
    "promptUser": "#F1FA8C",
    "promptHost": "#72C7F5",
    "promptDir": "#70DFE3",
    "promptArrow": "#80F29A",
    "cursorBg": "#AAAAAA",
    "toolbarMuted": "#88888D",
    "stopSquare": "#DC514E",
    "logoLime": "#A6E22E",
    "logoYellow": "#F1FA8C",
    "logoOrange": "#FFB86C",
    "logoCoral": "#FF6E67",
    "logoPink": "#FF79C6"
  },
  "border": {
    "hairline": "1px solid var(--color-border-subtle)",
    "strong": "1px solid var(--color-border-strong)",
    "focusRing": "2px solid var(--color-accent-primary)"
  },
  "elevation": {
    "0": "none",
    "1": "0 2px 8px rgba(0, 0, 0, 0.24)",
    "2": "0 8px 24px rgba(0, 0, 0, 0.36)",
    "3": "0 16px 48px rgba(0, 0, 0, 0.52)"
  },
  "motion": {
    "fast": "120ms cubic-bezier(0.16, 1, 0.3, 1)",
    "normal": "180ms cubic-bezier(0.16, 1, 0.3, 1)",
    "max": "200ms cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "density": {
    "comfortable": {
      "controlHeight": "36px",
      "controlPadding": "var(--space-2) var(--space-3)",
      "fontSize": "var(--font-size-md)",
      "gap": "var(--space-2)"
    },
    "compact": {
      "controlHeight": "28px",
      "controlPadding": "var(--space-1) var(--space-2)",
      "fontSize": "var(--font-size-sm)",
      "gap": "var(--space-1)"
    }
  },
  "surface": {
    "app": "var(--color-bg-canvas)",
    "nav": "var(--color-bg-surface)",
    "workspace": "var(--color-bg-elevated)",
    "workspaceBorder": "var(--color-border-subtle)"
  },
  "typography": {
    "fontSans": "'WebSSH Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "fontMono": "'WebSSH Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "sizeXs": "11px",
    "sizeSm": "12px",
    "sizeMd": "13px",
    "sizeLg": "15px",
    "sizeXl": "18px",
    "size2xl": "22px",
    "lineHeightUi": "1.45",
    "lineHeightTerminal": "1.35",
    "letterSpacingNormal": "0em",
    "letterSpacingTight": "-0.01em"
  },
  "themes": {
    "dark": {
      "bgCanvas": "#0B0D12",
      "bgSurface": "#141922",
      "bgElevated": "#1C2330",
      "bgOverlay": "rgba(17, 21, 29, 0.92)",
      "fgPrimary": "#E6EDF3",
      "fgSecondary": "#C9D4E8",
      "fgMuted": "#9AA8B8",
      "borderSubtle": "#2E3A4F",
      "borderStrong": "#4A5A78",
      "accentPrimary": "#4F8CFF",
      "accentHover": "#6EA1FF",
      "statusSuccess": "#2ea043",
      "statusWarning": "#d29922",
      "statusDanger": "#f85149",
      "terminalBg": "#0b0d12",
      "terminalFg": "#e6edf3",
      "terminalCursor": "#4f8cff",
      "terminalSelection": "rgba(79, 140, 255, 0.28)",
      "ansi": {
        "black": "#0b0d12",
        "red": "#ff7b72",
        "green": "#3fb950",
        "yellow": "#d29922",
        "blue": "#58a6ff",
        "magenta": "#bc8cff",
        "cyan": "#39c5cf",
        "white": "#b1bac4",
        "brightBlack": "#6e7681",
        "brightRed": "#ffa198",
        "brightGreen": "#56d364",
        "brightYellow": "#e3b341",
        "brightBlue": "#79c0ff",
        "brightMagenta": "#d2a8ff",
        "brightCyan": "#56d4dd",
        "brightWhite": "#ffffff"
      },
      "accentText": "#0B0D12"
    },
    "light": {
      "bgCanvas": "#F4F7FB",
      "bgSurface": "#FFFFFF",
      "bgElevated": "#EDF1F9",
      "bgOverlay": "rgba(255, 255, 255, 0.96)",
      "fgPrimary": "#172033",
      "fgSecondary": "#4A5568",
      "fgMuted": "#5B6878",
      "borderSubtle": "#DCE3EE",
      "borderStrong": "#C9D4E8",
      "accentPrimary": "#3157C8",
      "accentHover": "#2645A8",
      "statusSuccess": "#15731F",
      "statusWarning": "#7A4D00",
      "statusDanger": "#A30F1D",
      "terminalBg": "#FCFDFF",
      "terminalFg": "#172033",
      "terminalCursor": "#3157C8",
      "terminalSelection": "rgba(9, 105, 218, 0.22)",
      "ansi": {
        "black": "#24292f",
        "red": "#cf222e",
        "green": "#116329",
        "yellow": "#4d2d00",
        "blue": "#0969da",
        "magenta": "#8250df",
        "cyan": "#1b7c83",
        "white": "#6e7781",
        "brightBlack": "#57606a",
        "brightRed": "#a40e26",
        "brightGreen": "#1a7f37",
        "brightYellow": "#633c01",
        "brightBlue": "#218bff",
        "brightMagenta": "#a475f9",
        "brightCyan": "#3192aa",
        "brightWhite": "#8c959f"
      },
      "accentText": "#FFFFFF"
    },
    "high-contrast": {
      "bgCanvas": "#000000",
      "bgSurface": "#0a0c10",
      "bgElevated": "#141820",
      "bgOverlay": "rgba(0, 0, 0, 0.96)",
      "fgPrimary": "#ffffff",
      "fgSecondary": "#f0f6fc",
      "fgMuted": "#c9d1d9",
      "borderSubtle": "#7a828e",
      "borderStrong": "#ffffff",
      "accentPrimary": "#71b7ff",
      "accentHover": "#91cbff",
      "statusSuccess": "#26cd4d",
      "statusWarning": "#f0b72f",
      "statusDanger": "#ff6a69",
      "terminalBg": "#000000",
      "terminalFg": "#ffffff",
      "terminalCursor": "#71b7ff",
      "terminalSelection": "rgba(113, 183, 255, 0.45)",
      "ansi": {
        "black": "#000000",
        "red": "#ff6a69",
        "green": "#26cd4d",
        "yellow": "#f0b72f",
        "blue": "#71b7ff",
        "magenta": "#cb9eff",
        "cyan": "#39c5cf",
        "white": "#ffffff",
        "brightBlack": "#9ea7b3",
        "brightRed": "#ff9492",
        "brightGreen": "#4ae168",
        "brightYellow": "#f7c843",
        "brightBlue": "#91cbff",
        "brightMagenta": "#dbb7ff",
        "brightCyan": "#56d4dd",
        "brightWhite": "#ffffff"
      },
      "accentText": "#000000"
    }
  }
}