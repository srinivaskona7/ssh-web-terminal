{
  "name": "webssh-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/relay"
  ],
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "prebuild": "npm run tokens:build",
    "verify:build": "node scripts/verify-build.mjs",
    "build": "npm run tokens:build && npm --workspace=@webssh/protocol run build && npm --workspace=@webssh/ui-kit run build && npm --workspace=@webssh/web run build && node scripts/verify-build.mjs",
    "dev": "npm run tokens:build && npm --workspace=@webssh/web run dev",
    "preview": "npm --workspace=@webssh/web run preview",
    "typecheck": "npm run tokens:build && tsc -b packages/protocol packages/ui-kit apps/web && tsc -p apps/relay/tsconfig.json --noEmit",
    "lint": "npm run lint:tokens && npm run typecheck",
    "pretest": "npm run tokens:build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:go": "cd apps/gateway && go test -v -race -coverprofile=coverage.out ./...",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitest/coverage-v8": "^2.1.8",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "4.156.2"
  },
  "dependencies": {
    "@nanostores/preact": "^1.0.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "idb": "^8.0.1",
    "nanostores": "^1.2.0",
    "preact": "^10.25.3"
  }
}
